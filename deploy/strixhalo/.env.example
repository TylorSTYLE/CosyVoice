# deploy/strixhalo/.env.example
# 실제 값은 deploy/strixhalo/.env 에 넣고 커밋하지 않는다(.gitignore 처리됨).
# 서버에서: cp .env.example .env  후 필요한 값만 채운다.
#
# ⚠️ 여기에 변수를 "빈 값"으로 두면 env_file 이 이미지의 ENV 를 빈 문자열로 덮어쓴다.
#    특히 HSA_OVERRIDE_GFX_VERSION 은 이미지가 11.5.1 로 설정하므로 여기서 건드리지 말 것
#    (빈 값으로 덮으면 ROCm 이 gfx1151 을 못 잡아 GPU 인식 실패 → CPU 폴백).

# Hugging Face 토큰 (게이트/사설 모델 다운로드 시 필요, 공개 모델이면 비워도 됨)
HF_TOKEN=

# 서빙 포트 (host 포트). 컨테이너 내부는 8000 고정.
SERVE_PORT=8880
