# deploy/strixhalo/.env.example
# 실제 값은 deploy/strixhalo/.env 에 넣고 커밋하지 않는다(.gitignore 처리됨).
# 서버에서: cp .env.example .env  후 값 채우기.

# Hugging Face 토큰 (게이트/사설 모델 다운로드 시 필요, 공개 모델이면 비워도 됨)
HF_TOKEN=

# 사용할 모델 디렉터리(컨테이너 내부 경로). Phase 3 에서 다운로드해 채운다.
COSYVOICE_MODEL_DIR=/models/Fun-CosyVoice3-0.5B

# 서빙 포트
SERVE_PORT=8000

# gfx1151 override — Phase 1 에서 필요 여부 실측 후 설정(네이티브 TheRock 휠이면 비워둘 수 있음).
# 알려진 값: 11.5.1
HSA_OVERRIDE_GFX_VERSION=
